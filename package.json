{
  "name": "my-pics",
  "version": "1.10.0",
  "description": "My Pics photo editor",
  "main": "main.js",
  "author": "My Pics",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --x64 --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.mypics.app",
    "productName": "My Pics",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "update-config.json",
      "build/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "My-Pics-Setup.${ext}"
    },
    "portable": {
      "artifactName": "My-Pics-Portable.${ext}"
    },
    "afterPack": "afterPack.js",
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.photography"
    },
    "dmg": {
      "artifactName": "My-Pics-Mac-${arch}.${ext}"
    }
  }
}
